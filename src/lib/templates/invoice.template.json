{
  "type": "Invoice",
  "fields": [
    { "name": "vendor_name", "regex": "^(.*?(?:Inc\\.|LLC|Ltd\\.|Company|Corp\\.))" },
    { "name": "date", "regex": "(?:Date:?|Issued:?)\\s*(\\d{1,2}[-/]\\d{1,2}[-/]\\d{2,4}|[A-Z][a-z]+ \\d{1,2},? \\d{4})" },
    { "name": "total_amount", "regex": "(?:Total|Amount Due|Balance Due):?\\s*\\$?\\s*([0-9,]+\\.[0-9]{2})" }
  ]
}
