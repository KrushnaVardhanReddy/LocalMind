# ─────────────────────────────────────────────────────────────
# LocalMind — Environment Variables Template
# Copy this to .env.local and fill in your values.
# NEVER commit .env.local — it is in .gitignore.
# ─────────────────────────────────────────────────────────────

# Jules — AI coding agent API key
JULES_API_KEY=

# Cloudflare — For hosting LocalMind and the future AI Proxy
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ─────────────────────────────────────────────────────────────
# AI API Keys (BYOK - Bring Your Own Key mode)
# Only required if testing the AI features locally before Proxy
# ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
